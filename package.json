{
  "name": "edilmen-2027",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "EdilMen 2027 — il digital contractor: quotatore, rete di imprese convenzionate con rating, aree riservate e admin",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "seed:catalog": "node scripts/build-seed-catalog.js"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
